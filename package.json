{
  "name": "ai-email-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local email workspace with summaries, action items, and editable reply drafts.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check assistant.js && node --check gmail.js && node --check public/app.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "build:demo": "node scripts/build-static.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10"
  }
}
