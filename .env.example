# Optional. Without a key, the app runs in a clearly labelled offline demo mode.
# Enter your own key here or securely in your cloud environment settings.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=3000

# Optional Gmail OAuth. All four fields are needed to enable Connect Gmail.
# Keep .env private. Use secure environment settings on the deployed server.
APP_ORIGIN=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ALLOWED_EMAIL=
